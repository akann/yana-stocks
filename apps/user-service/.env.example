# Application
PORT=3004

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/yana_stocks

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Kafka
KAFKA_BROKERS=localhost:19092

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:3000

# SMTP (SMTP2GO)
SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=yanatech.co.uk
SMTP_PASSWORD=your-smtp2go-password
SMTP_FROM=info@yanatech.co.uk
