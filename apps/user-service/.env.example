# Application
PORT=3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/yana_stocks

# Redis
REDIS_URL=redis://localhost:6379

# JWT Access Token (15 minute expiry, stateless)
JWT_SECRET=change-me-dev-secret-minimum-32-characters-long
JWT_EXPIRES_IN=15m

# JWT Refresh Token (7 day expiry, stored in Redis, revocable)
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Kafka
KAFKA_BROKERS=localhost:19092
