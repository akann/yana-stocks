# Run on :3006 locally (auth-service=3004, portfolio-service=3005, portfolio-api=3006)
PORT=3006
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
AUTH_SERVICE_URL=http://localhost:3004
PORTFOLIO_SERVICE_URL=http://localhost:3005
PRICE_PROCESSOR_URL=http://localhost:3002
ML_PREDICTOR_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
SENTRY_DSN=
SENTIMENT_MONGODB_URI=mongodb://admin:password@localhost:27017/?authSource=admin
# Optional — if unset, /market/assets returns the curated dev asset list
MASSIVE_API_KEY=
# Optional — if unset, analyst ratings/sector performance/screener/movers fallback return empty
FMP_API_KEY=
# Optional — if unset, UK/international sector rotation returns empty
TWELVE_DATA_API_KEY=
