{
  "name": "@yana-stocks/portfolio-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "jest",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "seed": "tsx src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/swagger": "^11.4.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@sentry/nestjs": "^10.64.0",
    "@sentry/opentelemetry": "^10.64.0",
    "@yana-stocks/kafka-client": "workspace:*",
    "@yana-stocks/shared-dto": "workspace:*",
    "@yana-stocks/shared-types": "workspace:*",
    "axios": "^1.7.9",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.26",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@yana-stocks/eslint-config": "workspace:*",
    "@yana-stocks/typescript-config": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "jest": "^29.7.0",
    "pg": "^8.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": "(?<!\\.int)\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/main.ts",
      "!**/*.module.ts",
      "!**/*.decorator.ts",
      "!**/config/configuration.ts",
      "!**/scripts/**",
      "!**/generate-openapi.ts",
      "!**/tracing.ts",
      "!**/instrument.ts",
      "!**/logger.ts",
      "!**/metrics.ts",
      "!**/metrics.controller.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85
      }
    },
    "testEnvironment": "node"
  }
}
