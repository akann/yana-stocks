NEXT_PUBLIC_WS_URL=wss://api-gateway.yanatech.co.uk

# The browser only ever calls this app's own origin now — src/app/api/[...path]
# (the BFF) is what talks to the real backend server-to-server, attaching
# Authorization from the httpOnly access_token cookie. NEXT_PUBLIC_API_URL is
# gone; these are server-only env vars instead (see src/lib/bff/upstream.ts).

# Production (Kong API gateway, reached server-to-server):
API_GATEWAY_URL=https://api-gateway.yanatech.co.uk

# Dev: leave API_GATEWAY_URL unset — falls back to the per-service map below
# (no Kong running locally).
# AUTH_SERVICE_URL=http://localhost:3004
# PROFILE_SERVICE_URL=http://localhost:3007
# PORTFOLIO_API_URL=http://localhost:3006
