# Production (Kong API gateway)
NEXT_PUBLIC_API_URL=https://api-gateway.yanatech.co.uk/api
NEXT_PUBLIC_WS_URL=wss://api-gateway.yanatech.co.uk

# Dev: leave NEXT_PUBLIC_API_URL unset (defaults to http://localhost:3000/api)
# and Next.js rewrites proxy /api/* to the local services below.
# USER_SERVICE_URL=http://localhost:3004
# PORTFOLIO_API_URL=http://localhost:3006
