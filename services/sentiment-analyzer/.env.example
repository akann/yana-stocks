KAFKA_BROKERS=localhost:19092
MONGODB_URI=mongodb://localhost:27017/sentiment
FMP_API_KEY=your_fmp_api_key_here
HUGGINGFACE_MODEL=ProsusAI/finbert
POLL_INTERVAL_SECONDS=300
# Optional: override the default baseline ticker list (comma-separated)
# SYMBOLS=AAPL,GOOGL,TSLA
# Max symbols fetched from FMP per poll cycle (one request per symbol) —
# bounds burst size regardless of how large SYMBOLS or user
# portfolios/watchlists grow. We're on FMP's Starter plan (~300 req/min, no
# daily cap), so 50 is sized to cover the ~30-ticker baseline every cycle,
# not to survive the free tier's 250/day.
# MAX_SYMBOLS_PER_POLL=50
