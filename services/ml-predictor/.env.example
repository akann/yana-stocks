PORT=8000
KAFKA_BROKERS=localhost:19092
MONGODB_URI=mongodb://localhost:27017/prices
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yana-stocks-models
