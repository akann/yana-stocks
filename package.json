{
  "name": "yana-stocks",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "concurrently -n backend,frontend -c blue,cyan \"turbo run dev --filter=!@yana-stocks/frontend\" \"pnpm --filter @yana-stocks/frontend start\"",
    "test": "turbo test",
    "test:int": "turbo test:int",
    "test:cov": "turbo test:cov && pnpm test:cov:py",
    "test:cov:py": "for d in services/*/; do (cd \"$d\" && uv run pytest --cov=src) || exit 1; done",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "test:e2e": "pnpm --filter=e2e test:e2e",
    "test:lh": "pnpm --filter=frontend lighthouse",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "seed": "pnpm --filter @yana-stocks/portfolio-api seed",
    "prepare": "husky",
    "audit": "pnpm audit --audit-level=high",
    "scan": "gitleaks detect --redact",
    "scan:code": "knip --no-config-hints --no-tag-hints",
    "scan:trivy": "trivy fs . --severity CRITICAL,HIGH --ignore-unfixed --skip-dirs node_modules,.turbo,.next,dist,coverage"
  },
  "devDependencies": {
    "@yana-stocks/prettier-config": "workspace:*",
    "concurrently": "^10.0.3",
    "husky": "^9.1.7",
    "knip": "^6.21.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,css}": "prettier --write"
  },
  "prettier": "@yana-stocks/prettier-config",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
